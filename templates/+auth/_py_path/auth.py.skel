
import asyncio
import base64
import binascii
import functools
import getpass
import hashlib
import hmac
import json
import logging
import os
import secrets
import sys
import time
import urllib.parse

import {{ py_name }}


def arguments():
    {{ py_name }}.argparser.add_argument('--add-user',
        metavar='<user>',
        help='Add a user or change their password, then exit')

    {{ py_name }}.argparser.add_argument('--remove-user',
        metavar='<user>',
        help='Remove a user and end their sessions, then exit')

    {{ py_name }}.argparser.add_argument('--list-users',
        action='store_true',
        help='List the users, then exit')


def expires():
    '''hours that a login lasts'''
    return {{ py_name }}.config.getfloat('auth', 'expires', fallback=24)


def write_private(path, text):
    '''replace a file in one step, readable only by its owner'''
    fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as fp:
        fp.write(text)
    os.replace(path + '.tmp', path)


class Sessions:
    '''sessions and the secret that signs their cookies are saved to the
       sessions file, so logins survive a restart; with sessions left empty in
       the [auth] section they are only kept in memory'''

    def __init__(self):
        self.expires  = expires() * 3600
        self.sessions = {}
        self.secret   = None

        path = {{ py_name }}.config.get('auth', 'sessions', fallback='{{ lower_name }}.sessions')
        # relative paths are in the data directory
        self.path = {{ py_name }}.data(os.path.expanduser(path)) if path else None
        if not self.path:
            return

        try:
            with open(self.path, 'r') as fp:
                saved = json.load(fp)
            self.secret = saved['secret']
            for session_id,entry in saved['sessions'].items():
                self.sessions[session_id] = (entry['created'], entry['session'])
        except FileNotFoundError:
            pass
        except (OSError,ValueError,KeyError,TypeError,AttributeError) as e:
            raise {{ py_name }}.error('Could not read sessions: %s', e) from None

    def save(self):
        if not self.path:
            return
        sessions = {session_id:dict(created=created, session=session)
            for session_id,(created,session) in self.sessions.items()}
        try:
            write_private(self.path, {{ py_name }}.json_encode(dict(secret=self.secret, sessions=sessions)))
        except OSError as e:
            # logins still work, they just won't survive a restart
            logging.warning('Could not save sessions: %s', e)

    def cookie_secret(self):
        '''the saved secret, or None to use a new one for each start'''
        if self.path and not self.secret:
            self.secret = secrets.token_hex(32)
            self.save()
        return self.secret

    def save_session(self, session):
        now = time.time()
        # drop expired sessions as new ones arrive
        for session_id,(created,_session) in list(self.sessions.items()):
            if now - created > self.expires:
                del self.sessions[session_id]
        self.sessions[session['session_id']] = (now, session)
        self.save()

    def load_session(self, session_id):
        created,session = self.sessions.get(session_id, (0, None))
        if time.time() - created > self.expires:
            self.clear_session(session_id)
            return None
        return session

    def clear_session(self, session_id):
        if self.sessions.pop(session_id, None):
            self.save()


async def session(handler):
    '''the session for the request's session_id cookie, or None'''
    session_id = handler.get_signed_cookie('session_id', max_age_days=expires() / 24)
    if not session_id:
        return None
    session = await {{ py_name }}.wait({{ py_name }}.sessions.load_session(session_id.decode('utf-8')))
    # a removed user's sessions end, even while the app is running
    if session and session.get('username') not in read_users():
        return None
    return session


# users are kept in a file of user:hash lines, which is fine for a limited
# number of users; it's read again whenever it changes

def users_path():
    path = {{ py_name }}.config.get('auth', 'users', fallback='{{ lower_name }}.users')
    # relative paths are in the data directory
    return {{ py_name }}.data(os.path.expanduser(path))


_users = (None, {})

def read_users():
    global _users
    path = users_path()
    try:
        changed = (path, os.stat(path).st_mtime_ns)
        if changed == _users[0]:
            return _users[1]
        users = {}
        with open(path, 'r') as fp:
            for line in fp:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                username,stored = line.split(':', 1)
                users[username] = stored
    except FileNotFoundError:
        return {}
    except (OSError,ValueError) as e:
        raise {{ py_name }}.error('Could not read users: %s', e) from None
    _users = (changed, users)
    return users


def write_users(users):
    try:
        write_private(users_path(), ''.join(f'{username}:{stored}\n' for username,stored in users.items()))
    except OSError as e:
        raise {{ py_name }}.error('Could not write users: %s', e) from None


def manage_users():
    '''handle --add-user, --remove-user and --list-users, returns True if one was given'''
    args = {{ py_name }}.args
    users = dict(read_users())

    if args.add_user:
        username = args.add_user
        if ':' in username:
            raise {{ py_name }}.error('User names cannot contain ":"')

        # prompt on a terminal, otherwise read a line from stdin for scripts
        if sys.stdin.isatty():
            password = getpass.getpass(f'Password for {username}: ')
            if password != getpass.getpass('Again: '):
                raise {{ py_name }}.error('Passwords do not match')
        else:
            password = sys.stdin.readline().rstrip('\r\n')
        if not password:
            raise {{ py_name }}.error('No password given')

        users[username] = hash_password(password)
        write_users(users)
        logging.info('Saved user %s to %s', username, users_path())

    elif args.remove_user:
        if users.pop(args.remove_user, None) is None:
            raise {{ py_name }}.error('No user: %s', args.remove_user)
        write_users(users)
        logging.info('Removed user %s from %s', args.remove_user, users_path())

    elif args.list_users:
        for username in users:
            print(username)

    else:
        return False
    return True


async def check(username, password):
    '''true if the password is the user's'''
    stored = read_users().get(username)
    # hashing is CPU bound so keep it off the event loop
    if await asyncio.to_thread(verify_password, password, stored):
        return True
    logging.warning('Failed login: %s', username)
    return False


# scrypt parameters for new hashes, stored alongside each hash so they can be
# raised later without invalidating existing passwords
SCRYPT_N = 2 ** 15
SCRYPT_R = 8
SCRYPT_P = 1


def _scrypt(password, salt, n, r, p):
    return hashlib.scrypt(password.encode('utf-8'), salt=salt,
        n=n, r=r, p=p, maxmem=128 * r * (n + p + 2), dklen=64)


def hash_password(password):
    '''return a salted scrypt hash formatted as scrypt$n$r$p$salt$hash'''
    salt = os.urandom(16)
    digest = _scrypt(password, salt, SCRYPT_N, SCRYPT_R, SCRYPT_P)
    salt   = base64.b64encode(salt).decode('ascii')
    digest = base64.b64encode(digest).decode('ascii')
    return f'scrypt${SCRYPT_N}${SCRYPT_R}${SCRYPT_P}${salt}${digest}'


def verify_password(password, stored):
    '''check a password against a stored hash'''
    if not password:
        return False
    try:
        scheme,n,r,p,salt,digest = (stored or '').split('$')
        if scheme != 'scrypt':
            raise ValueError(scheme)
        n,r,p  = int(n), int(r), int(p)
        salt   = base64.b64decode(salt)
        digest = base64.b64decode(digest)
    except (ValueError,binascii.Error):
        # hash anyway, so unknown users take as long as wrong passwords
        _scrypt(password, b'', SCRYPT_N, SCRYPT_R, SCRYPT_P)
        return False
    return hmac.compare_digest(_scrypt(password, salt, n, r, p), digest)


# based on tornado.web.authenticated
def _next(handler):
    if handler.request.method in ('GET','HEAD'):
        url = handler.get_login_url()
        if '?' not in url:
            if urllib.parse.urlsplit(url).scheme:
                next_url = handler.request.full_url()
            else:
                next_url = handler.request.uri
            url += '?' + urllib.parse.urlencode(dict(next=next_url))
        handler.redirect(url)
    else:
        raise {{ py_name }}.HTTPError(403)


# call filter_func with the handler, the method is called if it returns true
def filter(filter_func):
    def _filter(method):
        @functools.wraps(method)
        def wrapper(self, *args, **kwds):
            if filter_func(self):
                return method(self, *args, **kwds)
            _next(self)
        return wrapper
    return _filter


# call filter_func with the session of a logged in user, the method is
# called if it returns true
def filter_user(filter_func):
    def _filter_user(method):
        @functools.wraps(method)
        def wrapper(self, *args, **kwds):
            if self.current_user:
                if filter_func(self.current_user):
                    return method(self, *args, **kwds)
            _next(self)
        return wrapper
    return _filter_user


# any logged in user
current_user = filter_user(lambda current_user: True)


# user name and password in the request, for command line tools
def basic(realm='{{ proper_name }}'):
    def basic_auth(method):
        @functools.wraps(method)
        async def wrapper(self, *args, **kwds):
            auth = self.request.headers.get('Authorization', '')
            if auth.startswith('Basic '):
                try:
                    auth = base64.b64decode(auth[6:]).decode('utf-8')
                    username,password = auth.split(':', 1)
                except (binascii.Error,UnicodeDecodeError,ValueError):
                    raise {{ py_name }}.HTTPError(400) from None
                if await check(username, password):
                    return await {{ py_name }}.wait(method(self, *args, **kwds))
            self.set_status(401)
            self.set_header('WWW-Authenticate', f'Basic realm="{realm}"')
            self.finish()
        return wrapper
    return basic_auth
