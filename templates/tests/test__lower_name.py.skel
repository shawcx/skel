{% if 'nginx' in features %}


def test_nginx(app):
    out = app.run('--nginx', '{{ lower_name }}.example.com')
    assert out.returncode == 0, out
    site = (app.tmp / 'nginx.conf').read_text()
    assert 'server_name {{ lower_name }}.example.com;' in site, site
{% end %}
{% if 'systemd' in features %}


def test_systemd(app):
    out = app.run('--systemd', 'nobody')
    assert out.returncode == 0, out
    service = (app.tmp / '{{ lower_name }}.service').read_text()
    assert 'User=nobody' in service and '-m {{ py_name }}' in service, service
{% end %}
