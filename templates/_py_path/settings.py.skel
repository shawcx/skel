
import argparse
import collections
import configparser
import inspect
import logging
import os
import sys
import time
import traceback

import {{ py_name }}


# override exit to set the stop event
class ArgParser(argparse.ArgumentParser):
    def exit(self, status=0, message=None):
        if message:
            self._print_message(message, sys.stderr)
        {{ py_name }}.{{ proper_name }}.stop()


{{ py_name }}.argparser = ArgParser(add_help=False)

{{ py_name }}.argparser.add_argument('--ini', '-I',
    metavar='<path>',
    help='Specify additional ini file')

{{ py_name }}.config = configparser.ConfigParser(
    allow_no_value = True,
    interpolation  = None,
    )
{{ py_name }}.config.optionxform = str


async def load(**kwds):
    {{ py_name }}.paths = {{ py_name }}.Paths('.')

    # if ns is not passed in use the supplied or derived ns
    ini_name = '{{ lower_name }}'
    ini_dir  = '{{ namespace or lower_name }}'

    # allow several locations for ini files
    ini_files = [
        #{{ py_name }}.paths(f'{ini_name}.ini'),
        #{{ py_name }}.paths(f'{ini_name}.ini.local'),
        os.path.join(os.path.sep, 'etc', f'{ini_dir}', f'{ini_name}.ini'),
        os.path.join(os.path.expanduser('~'), f'.{ini_name}.ini'),
        ]

    # first pass at parsing args to get additional ini files
    {{ py_name }}.args,remainder = {{ py_name }}.argparser.parse_known_args()

    # append a custom ini file if specified
    if {{ py_name }}.args.ini:
        ini_files.append({{ py_name }}.args.ini)

    # little hack because I like the generic options at the bottom of the help message
    {{ py_name }}.args.debug = '--debug' in remainder or '-D' in remainder
    logging.basicConfig(
        format  = '%(asctime)s %(levelname)-8s %(message)s',
        datefmt = '%Y-%m-%d %H:%M:%S',
        level   = logging.DEBUG if {{ py_name }}.args.debug else logging.INFO,
        force   = True
        )

    # load the ini files, at least one file must exist
    try:
        if {{ py_name }}.args.debug:
            for ini_file in ini_files:
                logging.debug('Loading ini file: %s', ini_file)
        ok = {{ py_name }}.config.read(ini_files)
    except configparser.ParsingError as e:
        raise {{ py_name }}.error('Unable to parse file: %s', e)

    if not ok:
        logging.warning('Unable to read config file(s):\n  %s', '\n  '.join(ini_files))

    # add the generic arguments after any components
    {{ py_name }}.argparser.add_argument('--debug', '-D',
        action='store_true',
        help='Log verbose debugging information')

    {{ py_name }}.argparser.add_argument('--version', '-V',
        action='store_true',
        help='Show version and exit'
        )

    {{ py_name }}.argparser.add_argument('--help', '-h',
        action='help', default=argparse.SUPPRESS,
        help='Show help message')

    {{ py_name }}.args = {{ py_name }}.argparser.parse_args()
