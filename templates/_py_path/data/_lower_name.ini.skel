[{{ lower_name }}]
address = 127.0.0.1
port    = 8080

# prepend a path to every route, useful behind a reverse proxy
#prefix = /{{ lower_name }}

# also log to {{ lower_name }}.log in the data directory
#logging = true

# secret for signed cookies, a random one is made at each start if not set
#cookie_secret =
{% if 'auth' in features %}

[auth]
# hours that a login lasts
#expires = 24
# user:hash lines written by --add-user, relative to the data directory
#users = {{ lower_name }}.users
{% end %}
{% if 'systemd' in features %}

# settings for --systemd, any {name} in systemd.service can be set here
[systemd]
#path = /etc/systemd/system/{{ lower_name }}.service
#user = {{ lower_name }}
{% end %}
