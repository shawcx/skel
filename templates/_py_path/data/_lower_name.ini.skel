[{{ lower_name }}]
{% if 'web' in features %}
address = 127.0.0.1
port    = 8080

# prepend a path to every route, useful behind a reverse proxy
#prefix = /{{ lower_name }}

{% end %}
# also log to {{ lower_name }}.log in the data directory
#logging = true
{% if 'web' in features %}

# secret for signed cookies, a random one is made at each start if not set
#cookie_secret =
{% end %}
{% if 'auth' in features %}

[auth]
# hours that a login lasts
#expires = 24
# user:hash lines written by --add-user, relative to the data directory
#users = {{ lower_name }}.users
# sessions and the cookie secret, so logins survive a restart, leave it
# empty to keep sessions in memory
#sessions = {{ lower_name }}.sessions
{% end %}
{% if 'sqlite' in features %}

[sqlite]
# the database file, relative to the data directory
#path = {{ lower_name }}.db
{% end %}
{% if 'nginx' in features %}

# settings for --nginx, any {name} in nginx.conf can be set here; a path of -
# prints the site, and with static_path empty the app serves the static files
[nginx]
#server_name = {{ lower_name }}.example.com
#path = /etc/nginx/sites-available/{server_name}
{% end %}
{% if 'systemd' in features %}

# settings for --systemd, any {name} in systemd.service can be set here
[systemd]
#path = /etc/systemd/system/{{ lower_name }}.service
#user = {{ lower_name }}
{% end %}
