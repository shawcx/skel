
import tornado.websocket

import {{ py_name }}


class WebSocket(tornado.websocket.WebSocketHandler):
    '''Tweak the default WebSocket behavior for more responsive behavior'''
    websockets = {}

    def initialize(self, websockets=None):
        if websockets is not None:
            self.websockets = websockets

    def check_origin(self, origin):
        # any origin is allowed while debugging, otherwise only the same host
        if {{ py_name }}.args.debug:
            return True
        return super().check_origin(origin)

    def open(self):
        self.set_nodelay(True)
        self.websockets[id(self)] = self

    # default behavior
    def on_message(self, msg):
        '''Reflect incoming messages to all other connected WebSockets'''
        # keep-alive sent by socket.js
        if msg == 'ping':
            return
        for ws in self.websockets.values():
            if ws is self:
                continue
            ws.write_message(msg)

    def on_close(self):
        self.websockets.pop(id(self), None)


class ProtectedSocket(WebSocket):
    '''Require a valid user session to establish WebSocket connection'''

    async def prepare(self):
        if {{ py_name }}.sessions is None:
            raise {{ py_name }}.HTTPError(500, 'No session component specified')

        self.session_id = self.get_secure_cookie('session_id')
        if not self.session_id:
            raise {{ py_name }}.HTTPError(403)
        self.session_id = self.session_id.decode('utf-8')

        self.session = await {{ py_name }}.wait({{ py_name }}.sessions.load_session(self.session_id))
        if not self.session:
            raise {{ py_name }}.HTTPError(403)
