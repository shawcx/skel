
import tornado.web

import {{ py_name }}

from .base import Handler


class Template(Handler):
    def initialize(self, template='index', **kwds):
        self.kwds = kwds
        self.template = template + '.html'
{% if 'auth' in features %}

    async def prepare(self):
        # so templates can show who is logged in
        self.current_user = await {{ py_name }}.auth.session(self)
{% end %}

    def get(self, template=None, *args):
        template = template + '.html' if template else self.template
        self.render(template, extra=args, **self.kwds)
{% if 'auth' in features %}


class Protected(Template):
    '''Require a logged in user, others are sent to the login page'''

    @tornado.web.authenticated
    def get(self, template=None, *args):
        super().get(template, *args)
{% end %}
