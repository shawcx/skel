import asyncio
import base64
import datetime
import inspect
import json
import logging
import os
import uuid

import {{ py_name }}


class error(Exception):
    '''generic error class for throwing exceptions'''

    def __init__(self, fmt, *args):
        self.message = fmt % args

    def __str__(self):
        return self.message


class Paths:
    def __init__(self, root=None):
        if root:
            self.root = root
        else:
            self.root = os.path.join(os.path.dirname(__file__), 'data')

    def __call__(self, *args):
        return os.path.join(self.root, *args)

    # support / as a path joiner
    def __truediv__(self, other):
        return Paths(self(other))

    def __str__(self):
        return self()


class JSONEncoder(json.JSONEncoder):
    '''encodes bytes, UUIDs, dates and times, and objects with an _as_dict()
       method; pass it explicitly or use json_encode, the json module is untouched'''
    def default(self, obj):
        if hasattr(obj, '_as_dict'):
            return obj._as_dict()
        if isinstance(obj, bytes):
            return base64.b64encode(obj).decode('ascii')
        if isinstance(obj, uuid.UUID):
            return str(obj)
        # ISO 8601, which covers datetime too as it's a date
        if isinstance(obj, (datetime.date, datetime.time)):
            return obj.isoformat()
        if isinstance(obj, datetime.timedelta):
            return obj.total_seconds()
        return json.JSONEncoder.default(self, obj)


def json_encode(obj, **kwds):
    '''json.dumps with JSONEncoder'''
    return json.dumps(obj, cls=JSONEncoder, **kwds)


async def wait(result):
    '''wait on coroutines or return result of non-coroutines'''
    try:
        return result if not asyncio.iscoroutine(result) else await result
    except Exception as e:
        if {{ py_name }}.args.debug:
            trace = []
            for f in inspect.stack()[:0:-1]:
                if not f.code_context:
                    continue
                context = '\n'.join(c.strip() for c in f.code_context)
                msg = f'  File "{f.filename}", line {f.lineno}, in {f.function}\n    {context}'
                trace.append(msg)
            logging.exception(f'Unhandled exception:\n%s', '\n'.join(trace))
        raise
