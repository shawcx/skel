{% import json %}{
  "name": "{{ lower_name }}",
  "version": "0.1.0",
  "description": "{{ proper_name }}",
  "private": true,
  "author": {{ json.dumps(__author__) }},
  "license": {{ json.dumps(__license__ or 'UNLICENSED') }},
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "backbone": "^1.6.1",
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "sass": "^1.102.0"
  }
}
