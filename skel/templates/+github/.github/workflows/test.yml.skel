name: test

on:
  push:
  pull_request:

jobs:
  test:
    strategy:
      fail-fast: false
      matrix:
        # the oldest Python that pyproject.toml supports and the newest
        python: ['3.11', '3.15']
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: ${{! matrix.python }}
      - run: python -m pip install '.[test]'
      - run: python -m pytest
{% if 'frontend' in features %}

  frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: 24
      - run: make -C src
{% end %}
