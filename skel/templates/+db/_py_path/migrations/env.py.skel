'''Alembic runs this for every migration command, on the connection from {{ py_name }}.migrations'''

from alembic import context

from {{ py_name }} import db
from {{ py_name }} import models

connection = context.config.attributes.get('connection')
if connection is None:
    raise SystemExit('{{ lower_name }} runs the migrations, see --migration in its --help')

context.configure(
    connection      = connection,
    target_metadata = db.Base.metadata,
    # SQLite can't change most columns in place, so a migration copies the table
    render_as_batch = connection.dialect.name == 'sqlite',
    )

with context.begin_transaction():
    context.run_migrations()
