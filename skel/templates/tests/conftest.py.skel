
import os
import socket
import subprocess
import sys
{% if 'web' in features %}
import time
import urllib.request
{% end %}

import pytest


ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
{% if 'postgres' in features %}

# the tests that start the app need a PostgreSQL database to use, for example
# TEST_POSTGRES_URL=postgresql://user:password@localhost/{{ lower_name }}_test
POSTGRES = os.environ.get('TEST_POSTGRES_URL')
{% end %}


def free_port():
    with socket.socket() as s:
        s.bind(('127.0.0.1', 0))
        return s.getsockname()[1]


class App:
    '''runs {{ proper_name }} with a test ini file, which keeps its files in a temp directory'''

    def __init__(self, tmp_path):
        self.tmp  = tmp_path
        self.ini  = tmp_path / 'test.ini'
        self.proc = None
        # the --ini file is read last, so it wins over local settings
        self.ini.write_text(f"""
[{{ lower_name }}]
{% if 'web' in features %}
address = 127.0.0.1
prefix  =
{% end %}
{% if 'auth' in features %}

[auth]
users    = {tmp_path / 'users'}
sessions = {tmp_path / 'sessions'}
{% end %}
{% if 'sqlite' in features %}

[sqlite]
path = {tmp_path / 'test.db'}
{% end %}
{% if 'nginx' in features %}

[nginx]
path = {tmp_path / 'nginx.conf'}
{% end %}
{% if 'systemd' in features %}

[systemd]
path = {tmp_path / '{{ lower_name }}.service'}
{% end %}
""")
{% if 'postgres' in features %}
        if POSTGRES:
            self.ini.write_text(self.ini.read_text() + f'\n[postgres]\nurl = {POSTGRES}\n')
{% end %}

    def command(self, *args):
        return [sys.executable, '-m', '{{ py_name }}', '--ini', str(self.ini), *args]

    def run(self, *args, input=None):
        '''run {{ proper_name }} with options such as --version, returns the completed process'''
        return subprocess.run(self.command(*args), cwd=self.tmp, env=dict(os.environ, PYTHONPATH=ROOT),
            input=input, capture_output=True, text=True)

{% if 'web' in features %}
    def start(self):
        '''start the server on a free port and wait until it answers'''
{% if 'postgres' in features %}
        if not POSTGRES:
            pytest.skip('needs a PostgreSQL database in TEST_POSTGRES_URL')
{% end %}
        self.port = free_port()
        self.proc = subprocess.Popen(self.command('--port', str(self.port)), cwd=self.tmp,
            env=dict(os.environ, PYTHONPATH=ROOT), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(100):
            try:
                urllib.request.urlopen(self.url('/static/favicon.ico')).close()
                return
            except OSError:
                time.sleep(0.1)
        raise AssertionError('{{ proper_name }} did not start')
{% else %}
    def start(self):
        '''start {{ proper_name }} and wait until it logs that it's running'''
{% if 'postgres' in features %}
        if not POSTGRES:
            pytest.skip('needs a PostgreSQL database in TEST_POSTGRES_URL')
{% end %}
        self.proc = subprocess.Popen(self.command(), cwd=self.tmp, env=dict(os.environ, PYTHONPATH=ROOT),
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        for line in self.proc.stderr:
            if '{{ proper_name }} is running' in line:
                return
        raise AssertionError('{{ proper_name }} did not start')
{% end %}

    def stop(self):
        '''stop it the way a service manager would, returns the exit code'''
        if self.proc:
            self.proc.terminate()
            code = self.proc.wait(10)
            self.proc = None
            return code
{% if 'web' in features %}

    def url(self, path, scheme='http'):
        return f'{scheme}://127.0.0.1:{self.port}{path}'
{% end %}


@pytest.fixture
def app(tmp_path):
    app = App(tmp_path)
    yield app
    app.stop()
