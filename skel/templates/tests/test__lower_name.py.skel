{% if 'db' in features %}


def test_migrations(database_url):
    '''the migrations make the tables that the models describe'''
    async def check():
        engine = sqlalchemy.ext.asyncio.create_async_engine(database_url)
        try:
            async with engine.begin() as conn:
                await conn.run_sync(migrations.migrate)
                return await conn.run_sync(migrations.differences)
        finally:
            await engine.dispose()

    changes = asyncio.run(check())
    assert not changes, f'the models have changes that no migration makes, run make migration: {changes}'
{% end %}
{% if 'db' in features and 'web' in features %}


def test_messages(app):
{% if 'auth' in features %}
    add_user(app, 'alice')
{% end %}
    app.start()

    async def check():
{% if 'auth' in features %}
        browser = Browser(app)
        rsp = await browser.get('/api/messages')
        assert rsp.code == 403, rsp
        await browser.get('/login')
        await browser.post('/login', username='alice', password='secret')
        fetch = browser.fetch
        socket = await open_socket(app, {'Cookie':f'session_id={browser.cookies["session_id"]}'})
{% else %}
        client = tornado.httpclient.AsyncHTTPClient()
        def fetch(path, **kwds):
            return client.fetch(app.url(path), raise_error=False, **kwds)
        socket = await open_socket(app)
{% end %}

        rsp = await fetch('/api/messages', method='POST', body=json.dumps({'text':'hi'}))
        assert rsp.code == 201 and json.loads(rsp.body)['text'] == 'hi', rsp
        # pages hear about it on the WebSocket
        sent = json.loads(await asyncio.wait_for(socket.read_message(), 5))
        assert sent == {'action':'add', 'collection':'messages', 'data':json.loads(rsp.body)}, sent
        rsp = await fetch('/api/messages', method='POST', body='{}')
        assert rsp.code == 400, rsp

        rsp = await fetch('/api/messages')
        assert 'hi' in [m['text'] for m in json.loads(rsp.body)['data']], rsp.body

    asyncio.run(check())
{% end %}
{% if 'nginx' in features %}


def test_nginx(app):
    out = app.run('--nginx', '{{ lower_name }}.example.com')
    assert out.returncode == 0, out
    site = (app.tmp / 'nginx.conf').read_text()
    assert 'server_name {{ lower_name }}.example.com;' in site, site
{% end %}
{% if 'systemd' in features %}


def test_systemd(app):
    out = app.run('--systemd', 'nobody')
    assert out.returncode == 0, out
    service = (app.tmp / '{{ lower_name }}.service').read_text()
    assert 'User=nobody' in service and '-m {{ py_name }}' in service, service
{% end %}
