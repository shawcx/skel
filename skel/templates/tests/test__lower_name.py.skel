def test_runs(app):
    app.start()
{% if 'sqlite' in features %}
    assert (app.tmp / 'test.db').exists()
{% end %}
    code = app.stop()
    # terminate() sends SIGTERM, which stops {{ proper_name }} cleanly, but on Windows it kills it
    if os.name == 'posix':
        assert code == 0
