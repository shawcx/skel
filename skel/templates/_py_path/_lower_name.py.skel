{% if 'web' in features %}
class {{ proper_name }}(tornado.web.Application):
{% else %}
class {{ proper_name }}:
{% end %}
    @classmethod
    def main(cls):
        '''run the application, returns the exit code'''
        {{ py_name }}.application = self = cls()
        try:
            asyncio.run(self._async_main())
        except {{ py_name }}.error as e:
            if {{ py_name }}.args.debug:
                traceback.print_tb(e.__traceback__)
            logging.error('%s', e)
            return 1
        return 0

    async def _async_main(self):
        self.loop = asyncio.get_running_loop()
        self._stop_event = asyncio.Event()

        signal.signal(signal.SIGINT,  self.__signalHandler)
        signal.signal(signal.SIGTERM, self.__signalHandler)
{% if 'web' in features %}

        self.patterns = []
        self.settings = {}

        {{ py_name }}.argparser.add_argument('--address', '-a',
            metavar='<address>',
            help = 'Interface to bind to')

        {{ py_name }}.argparser.add_argument('--port', '-p',
            metavar='<port>',
            type=int,
            help='Port to listen on')
{% end %}
{% if 'auth' in features %}

        auth.arguments()
{% end %}
{% if 'nginx' in features %}

        nginx.arguments()
{% end %}
{% if 'systemd' in features %}

        systemd.arguments()
{% end %}
{% if 'db' in features %}

        migrations.arguments()
{% end %}

        # errors go up to main, which logs them and exits with 1
        await {{ py_name }}.settings.load()
        await self.logging()
{% if 'nginx' in features %}

        # install the site instead of running
        if nginx.install():
            return
{% end %}
{% if 'systemd' in features %}

        # install the service instead of running
        if systemd.install():
            return
{% end %}
{% if 'auth' in features %}

        # manage users instead of running
        if auth.manage_users():
            return
{% end %}
{% if 'db' in features %}

        # write a migration instead of running
        if await migrations.write():
            return
{% end %}

        await self._async_init()

    async def _async_init(self, **kwds):
{% if 'auth' in features %}
        # sessions must provide save_session(), load_session() and clear_session()
        {{ py_name }}.sessions = auth.Sessions()

{% end %}
{% if 'db' in features %}
        await db.connect()

{% end %}
{% if 'web' in features %}
        self.settings['static_path']   = {{ py_name }}.data('static')
        self.settings['template_path'] = {{ py_name }}.data('templates')
        self.settings['debug']         = {{ py_name }}.args.debug
        if 'cookie_secret' not in self.settings:
            self.settings['cookie_secret'] = await self.cookie_secret()

{% end %}
        # call the application's entry point
        try:
            await {{ py_name }}.wait(self.initialize())
        except NotImplementedError:
            logging.warning('No "initialize" function defined')
{% if 'web' in features %}

{% if 'auth' in features %}
        patterns = [
            ( r'/login',  handlers.Login  ),
            ( r'/logout', handlers.Logout ),
            ]
        patterns.extend(self.patterns)
{% else %}
        patterns = list(self.patterns)
{% end %}

        # prepend prefix specified in the ini file, useful for nginx reverse proxy
        prefix = {{ py_name }}.settings.prefix()
        # templates and redirects add it to their links
        self.settings['prefix'] = prefix
        self.settings.setdefault('static_url_prefix', f'{prefix}/static/')
        if prefix:
            patterns = [(f'{prefix}{r[0]}',) + tuple(r[1:]) for r in patterns]
        else:
            patterns.append(
                ( r'/(favicon.ico)', tornado.web.StaticFileHandler, {'path':self.settings['static_path']}),
                )
{% if 'auth' in features %}
        self.settings['login_url'] = f'{prefix}/login'
{% end %}

        if {{ py_name }}.args.debug:
            for (pattern,cls,*params) in patterns:
                handler = f'{cls.__module__}.{cls.__name__}'
                logging.debug('%-32s %s %s', pattern, handler, params[0] if params else '')

        await self.__listen(patterns)
{% else %}

        logging.info('{{ proper_name }} is running')
{% end %}

        # block until the stop event is set
        await self._stop_event.wait()
        # call clean-up code
        await {{ py_name }}.wait(self.on_stop())
{% if 'db' in features %}
        await db.close()
{% end %}

{% if 'web' in features %}
    async def initialize(self):
        '''application entry point, add patterns and settings here'''
        self.patterns.extend([
{% if 'auth' in features %}
            ( r'/',   handlers.Protected       ),
            ( r'/ws', handlers.ProtectedSocket ),
{% else %}
            ( r'/',   handlers.Template  ),
            ( r'/ws', handlers.WebSocket ),
{% end %}
{% if 'db' in features %}
            ( r'/api/messages',          handlers.Messages   ),
            ( r'/api/messages/([0-9]+)', handlers.OneMessage ),
{% end %}
            ])
{% else %}
    async def initialize(self):
        '''application entry point, start tasks here'''
        # an example task, which runs every minute until the app stops
        self.periodic(60, self.heartbeat)

    def heartbeat(self):
        logging.debug('{{ proper_name }} is still running')
{% end %}

    async def logging(self):
        '''applications can override or extend this function'''

        # add the handlers to the logger
        if {{ py_name }}.config.getboolean('{{ lower_name }}', 'logging', fallback=False):
            full_path = {{ py_name }}.data('{{ lower_name }}.log')
            file_logger = logging.FileHandler(full_path)
            file_logger.setLevel(logging.DEBUG if {{ py_name }}.args.debug else logging.INFO)
            file_logger.setFormatter(
                logging.Formatter(
                    fmt = '%(asctime)s %(levelname)-8s %(message)s',
                    datefmt = '%Y-%m-%d %H:%M:%S',
                    )
                )
            root_logger = logging.getLogger()
            root_logger.addHandler(file_logger)

    async def sleep(self, _timeout):
        try:
            await asyncio.wait_for(self._stop_event.wait(), timeout=_timeout)
        except TimeoutError:
            return True
        return False

    def task(self, fn, *args, **kwds):
        async def _task():
            await {{ py_name }}.wait(fn(*args, **kwds))
        return asyncio.create_task(_task())

    def periodic(self, _timeout, fn, *args, **kwds):
        '''run a function or coroutine on a recurring basis'''
        async def _periodic():
            while True:
                # bail if the stop event is set
                # otherwise run the function after the timeout occurs
                try:
                    await asyncio.wait_for(self._stop_event.wait(), timeout=_timeout)
                    break
                except TimeoutError:
                    pass
                try:
                    await {{ py_name }}.wait(fn(*args, **kwds))
                except Exception as e:
                    logging.exception(e)
        return asyncio.create_task(_periodic())

    def stop(self):
        logging.debug('Setting stop event')
        self._stop_event.set()

    def on_stop(self):
        pass

    def __signalHandler(self, signum, frame):
        '''handle signals in a thread-safe way'''
        signame = signal.Signals(signum).name
        handler = getattr(self, f'on_{signame.lower()}', None)
        if handler:
            if handler(signum, frame):
                return
        logging.info('Terminating {{ proper_name }} on %s signal', signame)
        self.loop.call_soon_threadsafe(self.stop)

    # demonstrate a specific signal handler
    # and print newline after ^C on terminals
    def on_sigint(self, signum, frame):
        print()
{% if 'web' in features %}

    async def __listen(self, patterns, **kwds):
        '''call the Tornado Application init here to give children a chance
           to initialize patterns and settings'''
        super().__init__(patterns, **self.settings)

        if not {{ py_name }}.args.address:
            {{ py_name }}.args.address = {{ py_name }}.config.get('{{ lower_name }}', 'address', fallback='127.0.0.1')

        if not {{ py_name }}.args.port:
            {{ py_name }}.args.port = {{ py_name }}.config.getint('{{ lower_name }}', 'port', fallback=8080)

        if 'xheaders' not in kwds:
            kwds['xheaders'] = True

        try:
            self.listen({{ py_name }}.args.port, {{ py_name }}.args.address, **kwds)
            logging.info('Listening on %s:%d', {{ py_name }}.args.address, {{ py_name }}.args.port)
        except Exception as e:
            raise {{ py_name }}.error('%s', e) from None

    async def cookie_secret(self):
        '''applications can override this function'''
        secret = {{ py_name }}.config.get('{{ lower_name }}', 'cookie_secret', fallback=None)
{% if 'auth' in features %}
        if not secret:
            # saved with the sessions, so logins survive a restart
            secret = await {{ py_name }}.wait({{ py_name }}.sessions.cookie_secret())
{% end %}
        if not secret:
            logging.debug('No cookie_secret configured, signed cookies will not survive a restart')
            secret = secrets.token_hex(32)
        return secret
{% end %}
{% if 'auth' in features %}

    async def on_login_success(self, handler, username):
        '''return the session for a user who logged in, it must have a session_id
           and keep the username, and is saved as JSON'''
        return {
            'session_id' : secrets.token_urlsafe(32),
            'username'   : username,
            'agent'      : handler.request.headers.get('User-Agent', ''),
            'ip'         : handler.request.remote_ip,
            'time'       : time.time(),
            }

    async def on_login_failure(self, handler, username):
        '''called after a failed login'''
        pass

    async def on_logout(self, session_id):
        '''called before a session is cleared'''
        pass
{% end %}
