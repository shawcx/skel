import * as bootstrap from 'bootstrap'

import Collection from './collection.js'
import Socket from './socket.js'

// for scripts in the page, as Bootstrap's own bundle does
window.bootstrap = bootstrap


class {{ proper_name }} extends EventTarget {
    constructor() {
        super()
        // collections the server keeps up to date over the WebSocket, with messages like
        // {"action": "add", "collection": "messages", "data": {"id": 1, ...}}
        this.collections = {}

        this.on('connected', ()    => this.on_connected())
        this.on('add',       (msg) => this.on_add(msg))
        this.on('update',    (msg) => this.on_update(msg))
        this.on('delete',    (msg) => this.on_delete(msg))
    }

    on(action, fn) {
        this.addEventListener(action, (event) => fn(event.detail))
    }

    trigger(action, msg) {
        this.dispatchEvent(new CustomEvent(action, {detail: msg}))
    }

    collection(name, key = 'id') {
        return this.collections[name] ??= new Collection(key)
    }

    start(promises = []) {
        Promise.all(promises).then(() => {
            this.socket = new Socket({
                onopen: () => {
                    this.trigger('connected')
                },
                onmessage: ({action, ...msg}) => {
                    this.trigger(action, msg)
                }
            })
        })
    }

    on_connected() {
        console.info('Connected:', this.socket.wsurl)
    }

    on_add(msg) {
        this.collections[msg.collection]?.add(msg.data)
    }

    on_update(msg) {
        this.collections[msg.collection]?.update(msg.data)
    }

    on_delete(msg) {
        this.collections[msg.collection]?.remove(msg.id)
    }
}

// the script is at the end of the body, so the page is there already
window.app = new {{ proper_name }}()
app.start()

export default {{ proper_name }}
