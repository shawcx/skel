# the tests on the oldest Python that pyproject.toml supports and the newest{% if 'frontend' in features %},
# and the web assets build{% end %}

test:
  image: python:$PYTHON
  parallel:
    matrix:
      - PYTHON: ["3.11", "3.15"]
  script:
    - pip install -q '.[test]'
    - python -m pytest
{% if 'frontend' in features %}

frontend:
  image: node:24
  script:
    - make -C src
{% end %}
