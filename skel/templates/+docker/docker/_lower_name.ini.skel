# copied to /etc/{{ namespace or lower_name }}/{{ lower_name }}.ini in the image
[{{ lower_name }}]
{% if 'web' in features %}
# listen on every interface of the container, compose.yaml decides what reaches it
address = 0.0.0.0
port    = 8080
{% end %}
{% if 'auth' in features %}

[auth]
users    = /data/{{ lower_name }}.users
sessions = /data/{{ lower_name }}.sessions
{% end %}
{% if 'nginx' in features %}

[nginx]
# --nginx runs in the container, so it prints the site, which sends everything,
# static files too, to the port that compose publishes on this host
path        = -
address     = 127.0.0.1
static_path =
{% end %}
{% if 'postgres' in features %}

[postgres]
url           = postgresql://{{ lower_name }}@db/{{ lower_name }}
password_file = /run/secrets/db_password
{% end %}
{% if 'sqlite' in features %}

[sqlite]
path = /data/{{ lower_name }}.db
{% end %}
