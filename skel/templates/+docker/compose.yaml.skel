services:
  {{ lower_name }}:
    build: .
    restart: unless-stopped
{% if 'web' in features %}
    ports:
      # only this host can connect, put nginx or another proxy in front for others
      - "127.0.0.1:${PORT:-8080}:8080"
{% end %}
    volumes:
      - data:/data
{% if 'postgres' in features %}
    depends_on:
      db: { condition: service_healthy }
    secrets: [db_password]
{% end %}
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    deploy:
      resources:
        limits: { memory: 512m }
    logging:
      driver: local
{% if 'postgres' in features %}

  db:
    image: postgres:18.6-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ lower_name }}
      POSTGRES_DB: {{ lower_name }}
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
    secrets: [db_password]
    # only the app connects to it, over the compose network
    volumes:
      - db:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ lower_name }} -d {{ lower_name }}"]
      interval: 5s
      timeout: 3s
      retries: 20
    deploy:
      resources:
        limits: { memory: 512m }
    logging:
      driver: local
{% end %}

volumes:
  data: {}
{% if 'postgres' in features %}
  db: {}

secrets:
  db_password:
    # make it with: mkdir -p secrets && openssl rand -hex 24 > secrets/db_password.txt
    file: ./secrets/db_password.txt
{% end %}
