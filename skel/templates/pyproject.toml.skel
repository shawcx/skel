{% import json %}
[build-system]
requires      = ["setuptools>=77"]
build-backend = "setuptools.build_meta"

[project]
name            = "{{ lower_name }}"
description     = "{{ proper_name }}"
readme          = "README.md"
requires-python = ">=3.11"
dynamic         = ["version"]
dependencies    = [
{% if 'web' in features %}
    "tornado>=6.4",
{% end %}
{% if 'db' in features %}
    "alembic>=1.13",
    "sqlalchemy[asyncio]>=2.0",
{% end %}
{% if 'sqlite' in features %}
    "aiosqlite>=0.20",
{% end %}
{% if 'postgres' in features %}
    "asyncpg>=0.30",
{% end %}
]
{% if __license__ %}
license         = {{ json.dumps(__license__) }}
{% end %}
{% if __author__ %}
authors         = [{ name = {{ json.dumps(__author__) }}{% if __email__ %}, email = {{ json.dumps(__email__) }}{% end %} }]
{% end %}

[project.optional-dependencies]
test = ["pytest"]
dev  = ["build", "pytest"]
{% if __url__ %}

[project.urls]
Homepage = {{ json.dumps(__url__) }}
{% end %}

[project.scripts]
{{ lower_name }} = "{{ py_name }}.{{ lower_name }}:{{ proper_name }}.main"

[tool.pytest.ini_options]
testpaths  = ["tests"]
pythonpath = ["."]

[tool.setuptools.dynamic]
version = { attr = "{{ py_name }}.version.__version__" }

[tool.setuptools.packages.find]
include = ["{{ namespace or lower_name }}*"]

[tool.setuptools.package-data]
"{{ py_name }}" = ["data/**/*"{% if 'db' in features %}, "migrations/script.py.mako"{% end %}]

# files made at run time stay out of the wheel
[tool.setuptools.exclude-package-data]
"{{ py_name }}" = [
    "data/{{ lower_name }}.ini.local",
    "data/{{ lower_name }}.log",
{% if 'auth' in features %}
    "data/{{ lower_name }}.users",
    "data/{{ lower_name }}.sessions",
{% end %}
{% if 'sqlite' in features %}
    "data/{{ lower_name }}.db",
    "data/{{ lower_name }}.db-journal",
{% end %}
]
