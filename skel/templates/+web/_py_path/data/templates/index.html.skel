{%! extends 'base.template' %}

{%! block vars %}{%! set nav_home = "active" %}{%! end %}

{%! block scripts %}
{% if 'frontend' in features %}
<script src="{{! static_url('js/{{ lower_name }}.js') }}"></script>
{% end %}
{%! end %}

{%! block body %}
  <div class="card text-bg-dark">
    <h2 class="card-header">
      {{ proper_name }}
{% if 'auth' in features %}
{%! if current_user %}
      <span class="float-end">
        <small><i class="fa fa-user"></i> {{! current_user['username'] }}</small>
      </span>
{%! end %}
{% end %}
    </h2>
  </div>
{% if 'db' in features and 'frontend' in features %}
  <div class="card" id="messages">
    <h5 class="card-header">Messages</h5>
    <ul class="list-group list-group-flush"></ul>
    <div class="card-body">
      <form class="d-flex gap-2">
        <input type="text" class="form-control" name="text" placeholder="Say something" autocomplete="off" required>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    </div>
  </div>
{% end %}
{%! end %}
